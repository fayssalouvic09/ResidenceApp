[app]

# (str) اسم التطبيق الذي سيظهر على شاشة الهاتف للمستخدم
title = Residence App

# (str) الاسم البرمجي الداخلي للحزمة (بدون مسافات أو رموز)
package.name = residenceapp

# (str) النطاق البرمجي الفريد للمطور (يستخدم للتعريف)
package.domain = org.kebiri

# (str) المجلد الرئيسي الذي يحتوي على كود main.py (النقطة تعني المجلد الحالي)
source.dir = .

# (list) الامتدادات والصيغ التي يجب تضمينها داخل التطبيق (أضفنا docx لقراءة النماذج)
source.include_exts = py,png,jpg,kv,atlas,docx

# (str) إصدار التطبيق الحالي
version = 0.1

# (list) المكتبات والتبعيات البرمجية الضرورية لتشغيل الكود أوفلاين
# ملاحظة: تم تثبيت الحزم القياسية لتجنب تعارض المعالجة على نظام أندرويد
requirements = python3,kivy,six,python-docx

# (str) اتجاه شاشة الهاتف (شاشة عمودية تناسب حقول المدخلات)
orientation = portrait

# (bool) هل يعرض التطبيق بكامل الشاشة لإخفاء شريط الإشعارات (0 تعني لا)
fullscreen = 0

# =============================================================================
# إعدادات نظام أندرويد المتقدمة لتخطي أخطاء التجميع السحابي
# =============================================================================

# (int) الإصدار المستهدف من Android API (الإصدار 33 يتوافق مع أندرويد 13 فما فوق)
android.api = 33

# (int) الحد الأدنى المدعوم من أنظمة الأندرويد لتشغيل التطبيق
android.minapi = 21

# (bool) قبول تراخيص وأذونات SDK تلقائياً أثناء البناء
android.accept_sdk_license = True

# (str) البنية المعمارية للمعالجات المستهدفة لتشغيل التطبيق (معالجات الهواتف الحديثة)
android.archs = arm64-v8a, armeabi-v7a

# (int) مستوى طباعة سجلات البناء (2 تعني إظهار كافة التفاصيل والأخطاء بوضوح)
log_level = 2
